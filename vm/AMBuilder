import os

module = binary.Module(builder, 'vm')

if module.compiler.like('clang'):
  module.compiler.cxxflags += [
    '-Wno-implicit-exception-spec-mismatch',
  ]
if module.compiler.family == 'gcc':
  # ABI restrictions...
  module.compiler.cxxflags += [
    '-Wno-delete-non-virtual-dtor',
  ]

module.sources += [
  'api.cpp',
  'base-runtime.cpp',
  'legacy/builtins.cpp',
  'code-allocator.cpp',
  'code-stubs.cpp',
  'legacy/control-flow.cpp',
  'compiled-function.cpp',
  'debugging.cpp',
  'debug-metadata.cpp',
  'environment.cpp',
  'file-utils.cpp',
  'legacy/graph-builder.cpp',
  'legacy/interpreter.cpp',
  'md5/md5.cpp',
  'legacy/method-info.cpp',
  'legacy/method-verifier.cpp',
  'legacy/opcodes.cpp',
  'legacy/plugin-runtime.cpp',
  'rtti.cpp',
  'legacy/runtime-helpers.cpp',
  'legacy/scripted-invoker.cpp',
  'smx-image.cpp',
  'stack-frames.cpp',
  'watchdog_timer.cpp',
]

if 'SP_HAS_JIT' in module.compiler.defines:
  module.sources += [
    'legacy/jit.cpp',
    'linking.cpp',
  ]
  if module.compiler.target.arch == 'x86':
    module.sources += [
      'x86/code-stubs-x86.cpp',
      'x86/features-x86.cpp',
      'x86/jit_x86.cpp',
    ]
  elif module.compiler.target.arch == 'x86_64':
    module.sources += [
      'x64/assembler-x64.cpp',
      'x64/code-stubs-x64.cpp',
      'x64/features-x64.cpp',
      'x64/macro-assembler-x64.cpp',
      'x64/jit_x64.cpp',
    ]
