import os

binary = Root.Program(builder, 'impl_tests')

# Setup binary common flags and includes
SP.SetupBinForArch(binary, builder)

binary.compiler.includes += [
    os.path.join(builder.sourcePath, 'third_party', 'gtest', 'googletest', 'include'),
    os.path.join(builder.sourcePath, 'vm'),
]

binary.sources += [
    'heap_tests.cpp',
]

# Link with gtest and amtl
arch = binary.compiler.target.arch
binary.compiler.linkflags += [
    gtest,
    SP.libamtl[arch],
    SP.static_libsp[arch],
]

if binary.compiler.like('gcc'):
    binary.compiler.linkflags += ['-lpthread']

builder.Add(binary)
